DISCORD_TOKEN=

# Required: camps are run from the admin web page, which admins sign in to with Discord.
# Developer Portal > your application > OAuth2: copy the Client ID and Client
# Secret, and add the redirect {WEB_PUBLIC_URL}/auth/callback
# (http://localhost:8080/auth/callback with the defaults below).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
WEB_BIND=127.0.0.1:8080
WEB_PUBLIC_URL=http://localhost:8080

# Optional. Without a key, custom-match create is limited to 10 requests/hour per IP.
DEADLOCK_API_KEY=
DATABASE_URL=sqlite:data/camps.db
DEADLOCK_SERVER_REGION=
# Off by default. Set true to call Deadlock API and post a party code on Start match.
ENABLE_CUSTOM_MATCH_CREATE=false
# Pick/ban drafts on DeadChaps (https://www.deadchaps.gg/api). Needs a key with the
# drafts.write scope: ask for one in the DeadChaps Discord (#tickets > API Keys).
# Without it, turn the draft tool off on Configurações and share draft links yourself.
DEADCHAPS_API_KEY=

# Voice only — used to move players. The camp's messages go in the text channel
# picked when the camp is created on the admin page.
# If unset, the bot looks up or creates voice channels by name:
# Queue, Match 1 Hiddenking, Match 1 Archmother, Match 2 Hiddenking, Match 2 Archmother
QUEUE_VOICE_CHANNEL_ID=
MATCH1_HIDDENKING_VOICE_CHANNEL_ID=
MATCH1_ARCHMOTHER_VOICE_CHANNEL_ID=
MATCH2_HIDDENKING_VOICE_CHANNEL_ID=
MATCH2_ARCHMOTHER_VOICE_CHANNEL_ID=
